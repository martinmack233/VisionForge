<UserControl x:Class="VisionPlatform.Editor.Wpf.Workspace.NavigationRail" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:product="clr-namespace:VisionPlatform.Contracts.Build;assembly=VisionPlatform.Contracts">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanVisibility"/></UserControl.Resources>
  <Border Background="{DynamicResource StudioToolbox}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,1,0">
    <DockPanel Margin="9,12">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
        <Button Content="☰" Command="{Binding ToggleNavigationCommand}" ToolTip="展开或折叠导航栏" AutomationProperties.AutomationId="ToggleNavigation" HorizontalAlignment="Left" Padding="13,8"/>
        <TextBlock Text="{x:Static product:ProductBuild.Name}" Visibility="{Binding NavigationExpanded,Converter={StaticResource BooleanVisibility}}" FontWeight="Bold" Foreground="{DynamicResource StudioPrimary}" FontSize="15" Margin="8,14,0,0"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="视觉检测工作台" Visibility="{Binding NavigationExpanded,Converter={StaticResource BooleanVisibility}}" Foreground="{DynamicResource StudioMutedForeground}" FontSize="11" Margin="8,20,0,8"/>
      <ListBox ItemsSource="{Binding Navigation}" SelectedValue="{Binding CurrentPage,Mode=TwoWay}" SelectedValuePath="Page" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="WorkspaceNavigation">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="ToolTip" Value="{Binding Title}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0" CornerRadius="5" Padding="8,12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource StudioCardHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource StudioCardSelected}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Width="26" TextAlignment="Center" FontSize="18"/><TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" Margin="9,0,0,0" Visibility="{Binding DataContext.NavigationExpanded,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BooleanVisibility}}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
