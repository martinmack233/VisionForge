<UserControl x:Class="VisionPlatform.Editor.Wpf.Workspace.WorkspacePageHost" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:product="clr-namespace:VisionPlatform.Contracts.Build;assembly=VisionPlatform.Contracts" xmlns:local="clr-namespace:VisionPlatform.Editor.Wpf.Workspace">
  <UserControl.Resources>
    <local:WorkspacePageVisibilityConverter x:Key="PageVisibility"/>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource StudioPanel}"/><Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
    <Style x:Key="PageHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  </UserControl.Resources>
  <DockPanel Margin="24,20,12,14">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="首次配置 / 部署诊断" Click="Setup_Click"/><Button Content="工程包：导出 / 导入 / 重定位" Click="Packages_Click"/></WrapPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,10,0"><TextBlock Text="{Binding Notice}" Foreground="{DynamicResource StudioWarning}" TextWrapping="Wrap"/><TextBlock Text="{Binding Session.StatusMessage}" Foreground="{DynamicResource StudioMutedForeground}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Session.StatusMessage}"/></StackPanel>
    <Grid>
      <ContentControl x:Name="AiContent" Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=AI}"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=Dashboard}">
        <StackPanel>
          <TextBlock Text="视觉检测工作台" Style="{StaticResource PageHeading}"/>
          <TextBlock Text="打开工程或从示例开始，配置图像与检测流程。" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,0,0,24"/>
          <WrapPanel><Border Style="{StaticResource Card}" MinWidth="285"><StackPanel><TextBlock Text="检测工作状态" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="{Binding RuntimeStatus}" FontSize="19" Foreground="{DynamicResource StudioPrimary}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" MinWidth="250"><StackPanel><TextBlock Text="最近一次算法耗时" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="{Binding LastElapsed}" FontSize="23" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" MinWidth="220"><StackPanel><TextBlock Text="检测判定" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="{Binding CurrentDecision}" FontSize="20" Margin="0,8,0,0"/></StackPanel></Border></WrapPanel>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="开始一个视觉工程" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><WrapPanel><Button Content="新建工程" Command="{Binding NewCommand}" AutomationProperties.AutomationId="DashboardNew"/><Button Content="打开工程" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="DashboardOpen"/><Button Content="浏览常用算法示例" Command="{Binding ShowExamplesCommand}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="DashboardExamples"/></WrapPanel><TextBlock Text="离线示例涵盖图像处理、缺陷筛选、模板定位、逻辑判断和几何测量。选择方案后可查看完整节点流程并运行。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,15,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="最近工程" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding RecentProjects}"><ItemsControl.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Left" Command="{Binding DataContext.OpenRecentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="12,9" Margin="0,0,0,7"><DockPanel><TextBlock Text="{Binding Availability}" Foreground="{DynamicResource StudioMutedForeground}" DockPanel.Dock="Right" Margin="15,0,0,0"/><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource StudioMutedForeground}" TextTrimming="CharacterEllipsis" MaxWidth="780"/></StackPanel></DockPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="最近运行记录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><DataGrid ItemsSource="{Binding RunHistory}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" MaxHeight="220"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time,StringFormat=HH:mm:ss}" Width="100"/><DataGridTextColumn Header="工程" Binding="{Binding Project}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="ms" Binding="{Binding Milliseconds,StringFormat=F3}" Width="90"/></DataGrid.Columns></DataGrid></StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=Projects}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="工程管理" Style="{StaticResource PageHeading}"/><DockPanel Grid.Row="1" Margin="0,0,10,14"><Button Content="新建" Command="{Binding NewCommand}" DockPanel.Dock="Right"/><Button Content="打开工程" Command="{Binding OpenCommand}" DockPanel.Dock="Right"/><TextBox Text="{Binding ProjectSearch,UpdateSourceTrigger=PropertyChanged}" Padding="9,7" ToolTip="搜索最近工程名称或路径" AutomationProperties.AutomationId="ProjectSearch"/></DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject,Mode=TwoWay}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" SelectionMode="Single" Margin="0,0,10,12" AutomationProperties.AutomationId="ProjectsGrid"><DataGrid.Columns><DataGridTextColumn Header="工程名称" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="文件位置" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Availability}" Width="100"/><DataGridTextColumn Header="最近打开" Binding="{Binding LastOpened,StringFormat=g}" Width="150"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBox Text="{Binding ProjectInformation,Mode=OneWay}" IsReadOnly="True" BorderThickness="0" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel><Button Content="打开选中工程" Command="{Binding OpenRecentCommand}"/><TextBox Text="{Binding RenameText,UpdateSourceTrigger=PropertyChanged}" Width="185" Margin="8,0" ToolTip="工程显示名称；保留文件位置"/><Button Content="更新工程名称" Command="{Binding RenameProjectCommand}"/></WrapPanel><WrapPanel Margin="0,12,0,0"><TextBox Text="{Binding CopyName,UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,8,0" ToolTip="副本名称，留空则自动命名"/><Button Content="复制为新工程" Command="{Binding CopyProjectCommand}"/><TextBlock Text="资源引用保留在原位置" Foreground="{DynamicResource StudioMutedForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
      </Grid>
      <ContentControl x:Name="ExamplesContent" Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=Examples}"/>
      <ContentControl x:Name="DevicesContent" Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=Devices}"/>
      <Grid Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=Monitor}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="运行监控" Style="{StaticResource PageHeading}"/>
        <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding Session.ProjectName}" FontWeight="SemiBold" FontSize="18"/><WrapPanel Margin="0,12,0,0"><TextBlock Text="{Binding RuntimeStatus}" Margin="0,0,25,0"/><TextBlock Text="{Binding CurrentDecision}" FontWeight="Bold" Margin="0,0,25,0"/><TextBlock Text="{Binding LastElapsed}"/></WrapPanel><TextBlock Text="{Binding CommunicationStatus}" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,10,0,0"/></StackPanel></Border>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Session.Results}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" Margin="0,0,16,14"><DataGrid.Columns><DataGridTextColumn Header="节点" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="耗时 ms" Binding="{Binding Milliseconds,StringFormat=F3}" Width="110"/><DataGridTextColumn Header="错误原因" Binding="{Binding Error}" Width="2*"/></DataGrid.Columns></DataGrid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="运行日志（最近100条；不记录通信正文）" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox ItemsSource="{Binding Logs}" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,5"><TextBlock Text="{Binding Time,StringFormat=HH:mm:ss}" FontSize="11" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
      </Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CurrentPage,Converter={StaticResource PageVisibility},ConverterParameter=Settings}"><StackPanel><TextBlock Text="设置" Style="{StaticResource PageHeading}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="外观与语言" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="主题：浅蓝工业主题（默认）；深色切换接口保留。" Margin="0,14,0,6"/><TextBlock Text="语言：简体中文；多语言入口预留。" Foreground="{DynamicResource StudioMutedForeground}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="工作目录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="默认工程目录"/><TextBox Text="{Binding DefaultProjectDirectory,UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,5,0,14" AutomationProperties.AutomationId="DefaultProjectDirectory"/><TextBlock Text="示例工程目录"/><TextBox Text="{Binding ExamplesDirectory,UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,5,0,14" AutomationProperties.AutomationId="ExamplesDirectory"/><TextBlock Text="日志目录"/><TextBox Text="{Binding LogDirectory,UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,5,0,10"/><CheckBox Content="记录运行摘要日志（不保存通信正文）" IsChecked="{Binding LogEnabled}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="图像缓存" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveCacheDescription}" TextWrapping="Wrap" Margin="0,12,0,12"/><TextBlock Text="下次启动的结果图像预算（MiB，64..4096）"/><TextBox Text="{Binding ResultImageBudgetText,UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" Padding="8" Margin="0,5,0,5"/><TextBlock Text="预算约束调试中间图像保留；原始输入、WPF/GPU和原生工作区另计。" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap"/></StackPanel></Border><WrapPanel><Button Content="保存工作区设置" Command="{Binding SaveSettingsCommand}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="SaveWorkspaceSettings"/></WrapPanel><TextBlock Text="关于 视构 VisionForge" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock Text="{Binding Version}" TextWrapping="Wrap" AutomationProperties.AutomationId="ProductVersion"/><TextBlock Text="主要组件" FontWeight="SemiBold" Margin="0,12,0,4"/><TextBlock Text="{Binding Components}" TextWrapping="Wrap"/><TextBlock Text="独立 Runtime · WPF + Nodify · OpenCvSharp。许可证与已验证范围见随包文档。" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap" Margin="0,8,0,16"/></StackPanel></ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>

