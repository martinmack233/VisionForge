<UserControl x:Class="VisionPlatform.Editor.Wpf.AI.AiWorkspacePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ai="clr-namespace:VisionPlatform.Editor.Wpf.AI" Background="{DynamicResource StudioBackground}" Foreground="{DynamicResource StudioForeground}">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AiLayoutResources.xaml"/></ResourceDictionary.MergedDictionaries><ai:AiBitmapPathConverter x:Key="AiBitmapPath"/></ResourceDictionary></UserControl.Resources>
 <ScrollViewer x:Name="AiPageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid x:Name="AiPageBody" MinHeight="720" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10"><StackPanel DockPanel.Dock="Left"><TextBlock Text="AI 工作区" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="数据 · 标注 · 切片 · 训练 · 测试 · 模型部署" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,4"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding ConnectionDescription}" FontWeight="SemiBold" HorizontalAlignment="Right"/><WrapPanel Margin="0,5,0,0"><Button x:Name="ConnectWorkspaceButton" Content="连接工作区" Click="Connect_Click" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="AiConnect"/><Button Content="刷新" Click="Refresh_Click"/><Button Content="环境诊断" Click="Diagnose_Click"/></WrapPanel></StackPanel></DockPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,10">
   <Expander Header="工作区环境与数据目录（不会安装依赖或下载模型）" IsExpanded="False">
    <Border Style="{StaticResource AiPanel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="已有 YOLOStudio 代码目录" Style="{StaticResource AiLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="ChooseYoloRoot_Click"/><TextBox Text="{Binding YoloRoot}" ToolTip="{Binding YoloRoot}" Style="{StaticResource AiField}"/></DockPanel><TextBlock Text="已有 Python 环境" Style="{StaticResource AiLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="ChoosePython_Click"/><TextBox Text="{Binding PythonPath}" ToolTip="{Binding PythonPath}" Style="{StaticResource AiField}"/></DockPanel><TextBlock Text="服务入口（诊断）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding ServiceScript}" ToolTip="{Binding ServiceScript}" Style="{StaticResource AiField}"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="AI 数据目录（与程序目录分开）" Style="{StaticResource AiLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="ChooseDataHome_Click"/><TextBox Text="{Binding DataHome}" ToolTip="{Binding DataHome}" Style="{StaticResource AiField}"/></DockPanel><TextBlock Text="图像交换目录" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding TransferRoot}" ToolTip="{Binding TransferRoot}" Style="{StaticResource AiField}"/><TextBlock Text="原有数据不会搬移或清空。两个界面同时写入同一数据目录时会检测占用。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}"/></StackPanel>
    </Grid></Border>
   </Expander>
   <Expander x:Name="StarterGuide" Header="AI入门示例 · 从图片标注到训练部署" Margin="0,7,0,0"><Border Style="{StaticResource AiPanel}"><Grid MaxHeight="240"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><Grid Margin="0,0,10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="准备 / 打开AI示例" Click="PrepareStarter_Click" AutomationProperties.AutomationId="PrepareAiStarter"/><Button Content="新建一份独立示例" Click="NewStarter_Click"/><Button Content="查看离线资源" Click="OpenStarterResources_Click"/></WrapPanel><TextBlock Grid.Row="1" Text="{Binding StarterStatus}" Style="{StaticResource AiHint}" AutomationProperties.AutomationId="AiStarterStatus"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding StarterInstructions}" TextWrapping="Wrap"/></ScrollViewer></Grid><Image Grid.Column="1" Source="{Binding StarterPreviewPath,Converter={StaticResource AiBitmapPath}}" Stretch="Uniform" Margin="8"/></Grid></Border></Expander>
   <Border Style="{StaticResource AiPanel}" Margin="0,7,0,0"><WrapPanel><TextBlock Text="当前 AI 项目" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox Width="220" ItemsSource="{Binding Projects}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProject,Mode=TwoWay}" AutomationProperties.AutomationId="AiProject"/><TextBox Text="{Binding NewProjectName}" Width="170" Margin="10,0,6,0"/><Button Content="新建 AI 项目" Click="CreateProject_Click"/><Button Content="重命名" Click="RenameProject_Click"/><Button Content="删除AI项目" Click="DeleteProject_Click" Foreground="{DynamicResource StudioFailure}"/><Button Content="关联当前检测工程" Click="LinkProject_Click" ToolTip="关联两个独立ID，不复制或删除AI数据"/></WrapPanel></Border>
  </StackPanel>
  <TabControl Grid.Row="2" x:Name="AiTabs" AutomationProperties.AutomationId="AiWorkspaceTabs">
   <TabItem Header="项目与数据集"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><WrapPanel><Button Content="导入单张 / 多张" Click="ImportFiles_Click" AutomationProperties.AutomationId="AiImportFiles"/><Button Content="导入文件夹" Click="ImportFolder_Click"/><CheckBox x:Name="RecursiveImport" Content="包含子目录" VerticalAlignment="Center" Margin="5"/><Button Content="取消任务" Click="CancelTask_Click"/><Button Content="标记已检查 / 正常" Click="MarkReviewed_Click"/><Button Content="标记未检查" Click="MarkUnreviewed_Click"/></WrapPanel><WrapPanel Margin="0,6"><TextBox Text="{Binding SearchText}" Width="180" ToolTip="按文件名筛选"/><ComboBox ItemsSource="{Binding ReviewFilters}" SelectedItem="{Binding ReviewFilter}" Width="130" Margin="7,0"/><Button Content="筛选" Click="Filter_Click"/><TextBox Text="{Binding BatchName}" Width="150" ToolTip="采集批次" Margin="10,0,5,0"/><Button Content="设置所选批次" Click="AssignBatch_Click"/><Button Content="标注所选图片" Click="AnnotateSelected_Click"/><Button Content="删除所选记录" Click="DeleteImages_Click" Foreground="{DynamicResource StudioFailure}"/></WrapPanel></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ImageGallery" ItemsSource="{Binding Images}" SelectionMode="Extended" SelectionChanged="ImageSelection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AiImageGallery"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="150" Margin="4"><Border Height="108" Background="{DynamicResource StudioToolbox}" CornerRadius="4"><Image Source="{Binding ThumbnailPath,Converter={StaticResource AiBitmapPath}}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontWeight="SemiBold" Margin="0,5,0,2"/><TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap"/><TextBlock Text="{Binding Batch,StringFormat=批次：{0}}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"/>
     <Border Grid.Column="2" Style="{StaticResource AiPanel}" Padding="0"><ScrollViewer Style="{StaticResource AiSidebarScroll}"><StackPanel><TextBlock Text="类别与数据状态" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,10"/><TextBlock Text="已检查且无框才是正常样本；未检查图片不会自动作为负样本。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,0,0,10"/><ListBox ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4"><Border Background="{Binding Color}" Width="12" Height="12" Margin="0,0,8,0"/><TextBlock Text="{Binding Label}"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Text="{Binding ClassName}" Margin="0,10,0,5"/><TextBox Text="{Binding ClassColor}" ToolTip="类别颜色 #RRGGBB"/><WrapPanel Margin="0,8"><Button Content="新增类别" Click="AddClass_Click"/><Button Content="更新类别" Click="SaveClass_Click"/></WrapPanel><Button Content="打开当前图片位置" Click="OpenImageLocation_Click"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <WrapPanel Grid.Row="2" Margin="0,8"><Button Content="上一页" Click="PreviousPage_Click"/><TextBlock Text="{Binding PageDescription}" VerticalAlignment="Center" Margin="10,0"/><Button Content="下一页" Click="NextPage_Click"/></WrapPanel>
   </Grid></TabItem>
   <TabItem Header="图片标注"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="310" MinWidth="260"/></Grid.ColumnDefinitions><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel><Button Content="选择 / 移动 / 调整" Click="SelectAnnotation_Click" IsEnabled="{Binding HasAnnotationImage}"/><Button Content="绘制矩形" Click="DrawAnnotation_Click" IsEnabled="{Binding HasAnnotationImage}"/><Button Content="适应" Click="AnnotationFit_Click" IsEnabled="{Binding HasAnnotationImage}"/><Button Content="1:1 原像素" Click="AnnotationOneToOne_Click" IsEnabled="{Binding HasAnnotationImage}"/><Button Content="撤销 Ctrl+Z" Click="UndoAnnotation_Click" IsEnabled="{Binding HasAnnotationImage}"/><Button Content="保存" Click="SaveAnnotations_Click" IsEnabled="{Binding HasAnnotationImage}"/><Button Content="导入YOLO标签" Click="ImportLabels_Click"/><Button Content="导出YOLO标签" Click="ExportLabels_Click"/><Button Content="尺寸统计" Click="Analyze_Click" IsEnabled="{Binding HasAnnotationImage}"/><ComboBox Width="140" ItemsSource="{Binding Classes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedClass}"/></WrapPanel>
    <ai:AiAnnotationCanvas Grid.Row="1" x:Name="AnnotationCanvas" PreviewPath="{Binding PreviewPath}" SourceWidth="{Binding ImageWidth}" SourceHeight="{Binding ImageHeight}" Boxes="{Binding Boxes}" SelectedBox="{Binding SelectedBox,Mode=TwoWay}" Classes="{Binding Classes}" ActiveClass="{Binding SelectedClass}" Margin="0,7" AutomationProperties.AutomationId="AiAnnotationCanvas"/>
    <StackPanel Grid.Row="2"><TextBlock Text="{Binding AnnotationState}" TextWrapping="Wrap"/><TextBlock x:Name="AnnotationCoordinates" Text="原图像素 · A/D上下图 · 1～0/Ctrl/Alt组合选类 · Ctrl+K类别序号 · Delete删除" Foreground="{DynamicResource StudioMutedForeground}" FontSize="11"/></StackPanel>
   </Grid><GridSplitter Grid.Column="1" Width="4"/><Border Grid.Column="2" Style="{StaticResource AiPanel}" Padding="0"><ScrollViewer x:Name="AnnotationPropertiesScroll" Style="{StaticResource AiSidebarScroll}"><StackPanel>
    <StackPanel Style="{StaticResource AiSection}"><TextBlock Text="当前图片" Style="{StaticResource AiGroupTitle}"/><TextBlock Text="{Binding AnnotationImageDescription}" TextWrapping="Wrap" ToolTip="{Binding SelectedImage.Path}"/><Button Content="标记已检查 / 正常" Click="ReviewCurrent_Click" Style="{StaticResource AiSidebarButton}" IsEnabled="{Binding HasAnnotationImage}"/></StackPanel>
    <StackPanel Style="{StaticResource AiSection}"><TextBlock Text="标注列表" Style="{StaticResource AiGroupTitle}"/><TextBlock Text="{Binding AnnotationSelectionDescription}" Style="{StaticResource AiHint}"/><ListBox x:Name="AnnotationList" ItemsSource="{Binding Boxes}" SelectedItem="{Binding SelectedBox}" IsEnabled="{Binding HasAnnotationImage}" MinHeight="70" MaxHeight="180" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Id}" TextTrimming="CharacterEllipsis" Margin="4,5"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
    <StackPanel Style="{StaticResource AiSection}"><TextBlock Text="所选标注参数" Style="{StaticResource AiGroupTitle}"/><StackPanel IsEnabled="{Binding HasSelectedAnnotation}"><TextBlock Text="类别" Style="{StaticResource AiLabel}"/><ComboBox ItemsSource="{Binding Classes}" DisplayMemberPath="Name" SelectedItem="{Binding AnnotationClass}" Margin="0,0,0,8"/>
     <TextBlock Text="X（像素）" Style="{StaticResource AiLabel}"/><TextBox x:Name="AnnotationXInput" Text="{Binding AnnotationDraft.XText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AiCoordinateField}"/>
     <TextBlock Text="Y（像素）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding AnnotationDraft.YText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AiCoordinateField}"/>
     <TextBlock Text="宽度（像素）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding AnnotationDraft.WidthText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AiCoordinateField}"/>
     <TextBlock Text="高度（像素）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding AnnotationDraft.HeightText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AiCoordinateField}"/>
     <TextBlock Text="{Binding AnnotationEditError}" Style="{StaticResource AiInlineError}" AutomationProperties.AutomationId="AnnotationEditError"/>
     <Button x:Name="ApplyAnnotationButton" Content="应用坐标 / 类别" Click="ApplyCoordinates_Click" Style="{StaticResource AiSidebarButton}"/>
     <Button x:Name="DeleteAnnotationButton" Content="删除所选标注" Click="DeleteAnnotation_Click" Style="{StaticResource AiSidebarButton}" Foreground="{DynamicResource StudioFailure}"/>
    </StackPanel></StackPanel><StackPanel Style="{StaticResource AiSection}"><TextBlock Text="操作说明" Style="{StaticResource AiGroupTitle}"/><TextBlock Text="拖动框体移动，拖动角点调整。显示保留3位小数，未编辑字段保留完整精度。输入错误时保留草稿；点击应用通过校验后才写回并自动保存。缩放不改变原图坐标。完整标注ID可在列表提示中查看。" Style="{StaticResource AiHint}"/></StackPanel>
   </StackPanel></ScrollViewer></Border></Grid></TabItem>
   <TabItem Header="线扫切片与数据准备"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.ColumnSpan="3" Padding="10" Margin="0,0,0,10" Background="{DynamicResource StudioToolbox}"><DockPanel><Button DockPanel.Dock="Right" Content="用于模型训练" Click="UseDatasetForTraining_Click" IsEnabled="{Binding CanUsePreparedDataset}" AutomationProperties.AutomationId="UseDatasetForTraining" Margin="10,0,0,0"/><StackPanel><TextBlock Text="{Binding DataPreparationStatus}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="DataPreparationStatus"/><TextBlock Text="{Binding PreparedDatasetPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreparedDatasetPath}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DockPanel></Border><ScrollViewer Grid.Row="1" Style="{StaticResource AiSidebarScroll}"><StackPanel>
    <TextBlock Text="切片与标签映射" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="切片宽 / 高" Style="{StaticResource AiLabel}"/><UniformGrid Columns="2"><TextBox Text="{Binding TileWidthText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding TileHeightText}" Style="{StaticResource AiField}"/></UniformGrid><TextBlock Text="重叠比例 / 边界处理" Style="{StaticResource AiLabel}"/><UniformGrid Columns="2"><TextBox Text="{Binding OverlapText}" Style="{StaticResource AiField}"/><ComboBox ItemsSource="{Binding BoundaryModes}" SelectedItem="{Binding BoundaryMode}"/></UniformGrid><TextBlock Text="预览切片编号（-1为网格，0为首片）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding TileIndexText}"/><Button Content="实际切片预览" Click="PreviewSlices_Click" Margin="0,8"/><Button Content="开始切片处理" Click="StartSlices_Click"/><Separator Margin="0,10"/>
    <TextBlock Text="数据集划分" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="按原图 / 采集批次先划分，再切片，避免泄漏。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}"/><ComboBox ItemsSource="{Binding Groupings}" SelectedItem="{Binding Grouping}" Margin="0,7"/><TextBlock Text="训练 / 验证 / 测试比例（合计1）" Style="{StaticResource AiLabel}"/><UniformGrid Columns="3"><TextBox Text="{Binding TrainRatioText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding ValidationRatioText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding TestRatioText}" Style="{StaticResource AiField}"/></UniformGrid><CheckBox Content="划分后生成切片数据集" IsChecked="{Binding DatasetTiled}"/>
    <TextBlock Text="16位灰度预处理（实际数据快照）" Style="{StaticResource AiLabel}"/><ComboBox ItemsSource="{Binding GrayMappings}" SelectedItem="{Binding GrayMapping}"/><UniformGrid Columns="2" Margin="0,7"><TextBox Text="{Binding GrayLowText}" Style="{StaticResource AiField}" ToolTip="低分位"/><TextBox Text="{Binding GrayHighText}" Style="{StaticResource AiField}" ToolTip="高分位"/></UniformGrid><TextBlock Text="固定映射下限 / 上限 / Gamma" Style="{StaticResource AiLabel}"/><UniformGrid Columns="3"><TextBox Text="{Binding GrayFixedLowText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding GrayFixedHighText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding GammaText}" Style="{StaticResource AiField}"/></UniformGrid><Button Content="保存项目预处理快照" Click="SavePreprocessing_Click"/><TextBlock Text="输出父目录（留空使用项目目录）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding DatasetOutput}" ToolTip="{Binding DatasetOutput}"/><Button Content="生成可训练数据集" Click="BuildDataset_Click" Style="{DynamicResource StudioPrimaryButton}" Margin="0,9"/><Button Content="取消当前任务" Click="CancelTask_Click"/>
   </StackPanel></ScrollViewer><Grid Grid.Row="1" Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions><ai:AiAnnotationCanvas x:Name="SliceCanvas" IsReadOnly="True" PreviewPath="{Binding SlicePreviewPath}" SourceWidth="{Binding SliceImageWidth}" SourceHeight="{Binding SliceImageHeight}" Boxes="{Binding SliceBoxes}" Classes="{Binding Classes}"/><GroupBox Grid.Row="1" Header="处理历史与预处理快照" Margin="0,8,0,0"><ListBox ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="4"/></DataTemplate></ListBox.ItemTemplate></ListBox></GroupBox></Grid></Grid></TabItem>
   <TabItem Header="模型训练"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer Style="{StaticResource AiSidebarScroll}"><StackPanel>
    <TextBlock Text="训练配置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding TrainingContextError}" Style="{StaticResource AiInlineError}"/><TextBlock Text="数据集 data.yaml" Style="{StaticResource AiLabel}"/><ComboBox IsEditable="True" ItemsSource="{Binding DatasetPaths}" x:Name="TrainingDatasetInput" Text="{Binding TrainingDataset,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TrainingDataset}"/><Button Content="选择数据集" Click="ChooseTrainingDataset_Click" Margin="0,5"/><TextBlock Text="{Binding TrainingDatasetError}" Style="{StaticResource AiInlineError}"/><TextBlock Text="本机初始权重（不自动下载）" Style="{StaticResource AiLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="选择" Click="ChooseTrainingModel_Click"/><TextBox x:Name="TrainingModelInput" Text="{Binding TrainingModel,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TrainingModel}"/></DockPanel><TextBlock Text="请选择已有本地 .pt 初始权重，程序不会自动下载。" Style="{StaticResource AiHint}"/><TextBlock Text="{Binding TrainingModelError}" Style="{StaticResource AiInlineError}" AutomationProperties.AutomationId="TrainingModelError"/><TextBlock Text="CUDA 设备编号（原训练服务）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding Device}"/><TextBlock Text="epochs / batch / 输入尺寸" Style="{StaticResource AiLabel}"/><UniformGrid Columns="3"><TextBox x:Name="TrainingEpochsInput" Text="{Binding EpochsText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AiField}"/><TextBox Text="{Binding BatchText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding InputSizeText}" Style="{StaticResource AiField}"/></UniformGrid><TextBlock Text="优化器 / 学习率" Style="{StaticResource AiLabel}"/><ComboBox ItemsSource="{Binding Optimizers}" SelectedItem="{Binding Optimizer}"/><TextBox Text="{Binding LearningRateText}" Margin="0,6"/><CheckBox Content="混合精度 AMP" IsChecked="{Binding UseAmp}"/><TextBlock Text="{Binding TrainingSettingsError}" Style="{StaticResource AiInlineError}"/><WrapPanel Margin="0,10"><Button Content="开始训练" Click="Train_Click" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="AiTrain"/><Button Content="安全停止" Click="StopTraining_Click"/><Button Content="恢复训练" Click="ResumeTraining_Click"/></WrapPanel><TextBlock Text="页面切换不终止训练。日志、Epoch与曲线均来自实际任务；无指标时不显示模拟曲线。GPU占用由原任务锁协调。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}"/><Button Content="打开训练输出目录" Click="OpenTrainingOutput_Click" Margin="0,8"/>
   </StackPanel></ScrollViewer><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="1*"/><RowDefinition Height="1*"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding TrainingHistory}" SelectedItem="{Binding SelectedTask}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Epoch" Binding="{Binding Current}" Width="65"/><DataGridTextColumn Header="模型" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><ai:AiTrainingChart Grid.Row="1" Points="{Binding Metrics}" MinHeight="150" Margin="0,8"/><TextBox Grid.Row="2" Text="{Binding LogText,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11" ToolTip="真实训练日志（有界显示最近256000字符）"/></Grid></Grid></TabItem>
   <TabItem Header="模型测试与评估"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer Style="{StaticResource AiSidebarScroll}"><StackPanel>
    <TextBlock Text="测试模型" FontSize="17" FontWeight="SemiBold"/><ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedTestModel}" DisplayMemberPath="Label" Margin="0,7" ToolTip="选择已有训练模型或已导出模型；也可在下方手动浏览。"/><TextBlock Text="{Binding TestModelDescription}" TextWrapping="Wrap" FontSize="11" Margin="0,4"/><DockPanel Margin="0,8"><Button DockPanel.Dock="Right" Content="选择" Click="ChooseTestModel_Click"/><TextBox Text="{Binding TestModelPath,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TestModelPath}"/></DockPanel><UniformGrid Columns="2"><StackPanel><TextBlock Text="显式推理后端" Style="{StaticResource AiLabel}"/><ComboBox ItemsSource="{Binding TestBackends}" SelectedItem="{Binding TestBackend}"/></StackPanel><StackPanel Margin="8,0,0,0"><TextBlock Text="设备 cpu / GPU编号" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding TestDevice}"/></StackPanel></UniformGrid><TextBlock Text="输入尺寸 / 检测批大小" Style="{StaticResource AiLabel}"/><UniformGrid Columns="2"><TextBox Text="{Binding TestInputSizeText,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TestSizeEditable}" Style="{StaticResource AiField}"/><TextBox Text="{Binding TestBatchText,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding TestBatchEditable}" Style="{StaticResource AiField}"/></UniformGrid><Button Content="校验实际模型输入" Click="InspectTestInput_Click"/><TextBlock Text="{Binding TestContractMessage}" TextWrapping="Wrap" Margin="0,6,0,8"/><TextBlock Text="置信度 / IoU / 合并IoU" Style="{StaticResource AiLabel}"/><UniformGrid Columns="3"><TextBox Text="{Binding ConfidenceText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding IouText}" Style="{StaticResource AiField}"/><TextBox Text="{Binding MergeIouText}" Style="{StaticResource AiField}"/></UniformGrid><TextBlock Text="类别ID（留空为全部）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding ClassIdsText}"/><CheckBox Content="线扫分块推理" IsChecked="{Binding TestTiled}" Margin="0,8"/><TextBlock Text="切片尺寸与重叠沿用数据准备页，坐标由原服务还原。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="单图、多图或文件夹（每行一个路径）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding TestInputsText}" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,6"><Button Content="添加图片" Click="ChooseTestImages_Click"/><Button Content="添加文件夹" Click="ChooseTestFolder_Click"/><Button Content="使用项目图片" Click="UseProjectImages_Click"/></WrapPanel><WrapPanel><Button Content="开始检测" Click="Infer_Click" Style="{DynamicResource StudioPrimaryButton}"/><Button Content="取消" Click="CancelTask_Click"/><Button Content="刷新结果" Click="RefreshResults_Click"/></WrapPanel><TextBlock Text="评估数据集" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding EvaluationDataset}"/><TextBlock Text="ONNX对照模型" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding CompareOnnxPath}"/><WrapPanel Margin="0,7"><Button Content="真实标签评估" Click="Evaluate_Click"/><Button Content="PT / ONNX 对照" Click="Compare_Click"/></WrapPanel><TextBlock Text="部署到视觉流程仍使用已验证的 ONNX CPU 节点。PT/CUDA仅在此页显式选择，并由原引擎校验。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" FontSize="11"/><WrapPanel Margin="0,8"><Button Content="应用到当前YOLO节点" Click="ApplyModel_Click"/><Button Content="创建YOLO检测节点" Click="CreateYoloNode_Click"/></WrapPanel></StackPanel></ScrollViewer>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions><DockPanel><WrapPanel DockPanel.Dock="Top"><TextBlock Text="检测图片" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox ItemsSource="{Binding InferenceImages}" SelectedItem="{Binding SelectedInferenceImage}" DisplayMemberPath="Name" Width="220"/><TextBlock Text="{Binding ResultPageDescription}" VerticalAlignment="Center" Margin="8,0"/><Button Content="上一页" Click="PreviousResultPage_Click"/><Button Content="下一页" Click="NextResultPage_Click"/></WrapPanel><ai:AiAnnotationCanvas x:Name="TestCanvas" PreviewPath="{Binding TestPreviewPath}" SourceWidth="{Binding TestImageWidth}" SourceHeight="{Binding TestImageHeight}" Boxes="{Binding DetectionBoxes}" Classes="{Binding DetectionClasses}" IsReadOnly="True"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding TestSummary}" TextWrapping="Wrap" Margin="0,7"/><DataGrid Grid.Row="2" ItemsSource="{Binding Detections}" SelectedItem="{Binding SelectedDetection}" SelectionChanged="DetectionSelection_Changed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="类别" Binding="{Binding ClassName}" Width="*"/><DataGridTextColumn Header="置信度" Binding="{Binding Confidence,StringFormat=F4}"/><DataGridTextColumn Header="X" Binding="{Binding X,StringFormat=F2}"/><DataGridTextColumn Header="Y" Binding="{Binding Y,StringFormat=F2}"/><DataGridTextColumn Header="宽" Binding="{Binding Width,StringFormat=F2}"/><DataGridTextColumn Header="高" Binding="{Binding Height,StringFormat=F2}"/></DataGrid.Columns></DataGrid></Grid>
   </Grid></TabItem>
   <TabItem Header="模型管理与部署"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button Content="刷新模型" Click="RefreshModels_Click"/><Button Content="用于测试" Click="UseModelForTest_Click"/><Button Content="打开模型位置" Click="OpenModelLocation_Click"/><Button Content="校验部署契约" Click="InspectDeployment_Click"/><Button Content="应用到当前YOLO节点" Click="ApplyModel_Click" Style="{DynamicResource StudioPrimaryButton}"/><Button Content="创建YOLO检测节点" Click="CreateYoloNode_Click"/></WrapPanel>
    <Grid Grid.Row="1" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="模型" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="可用性" Binding="{Binding Availability}" Width="85"/><DataGridTextColumn Header="训练来源" Binding="{Binding RunId}" Width="*"/><DataGridTextColumn Header="创建时间" Binding="{Binding Created}" Width="*"/></DataGrid.Columns></DataGrid><ScrollViewer Grid.Column="2" Style="{StaticResource AiSidebarScroll}"><StackPanel><TextBlock Text="模型身份与来源" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedModel.Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedModel.Path}" Margin="0,8"/><TextBlock Text="{Binding SelectedModel.Sha256,StringFormat=SHA256：{0}}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedModel.Metrics}" TextWrapping="Wrap" Margin="0,8"/><TextBlock Text="PT 导出 ONNX" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding ExportModelPath}" ToolTip="{Binding ExportModelPath}" Margin="0,8"/><TextBlock Text="导出目录（由原服务保护）" Style="{StaticResource AiLabel}"/><TextBox Text="{Binding ExportDirectory}"/><UniformGrid Columns="2" Margin="0,7"><StackPanel><TextBlock Text="Opset"/><TextBox Text="{Binding ExportOpsetText}"/></StackPanel><StackPanel Margin="8,0,0,0"><CheckBox Content="动态输入" IsChecked="{Binding ExportDynamic}"/><CheckBox Content="FP16（需环境支持）" IsChecked="{Binding ExportHalf}"/></StackPanel></UniformGrid><Button Content="导出 ONNX 与 deployment.json" Click="ExportModel_Click"/><TextBlock Text="训练、测试和已应用节点的模型分别管理。完成训练或导出不会自动替换检测模型。" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap" Margin="0,10"/><Expander Header="部署校验详情"><TextBox Text="{Binding DeploymentInfo,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="260" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></ScrollViewer></Grid>
    <Expander Grid.Row="2" Header="任务与诊断" IsExpanded="False"><Grid><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Id}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/><DataGridTextColumn Header="进度" Binding="{Binding ProgressText}"/><DataGridTextColumn Header="消息" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="1" Text="{Binding Diagnostic,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MaxHeight="120" VerticalScrollBarVisibility="Auto"/></Grid></Expander>
   </Grid></TabItem>
  </TabControl>
  <StackPanel Grid.Row="3" Margin="0,9,0,0"><ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding SelectedTask.Percent,Mode=OneWay}"/><TextBlock Text="{Binding SelectedTask.ProgressText}" Foreground="{DynamicResource StudioMutedForeground}" FontSize="10"/><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.AutomationId="AiStatus"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource StudioFailure}" TextWrapping="Wrap" MaxHeight="70" ToolTip="{Binding Error}" AutomationProperties.AutomationId="AiError"/></StackPanel>
 </Grid>
 </ScrollViewer>
</UserControl>
