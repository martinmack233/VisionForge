<UserControl x:Class="VisionPlatform.Editor.Wpf.Examples.ExamplesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource StudioBackground}" Foreground="{DynamicResource StudioForeground}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="GuideVisibility"/></UserControl.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="方案示例中心" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="选择完整离线方案，查看流程、创建工程副本并运行真实算法。" Margin="0,6,0,12" Foreground="{DynamicResource StudioMutedForeground}"/>
   <Border Background="{DynamicResource StudioToolbox}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10" Visibility="{Binding HasBeginnerExamples,Converter={StaticResource GuideVisibility}}"><DockPanel><Button DockPanel.Dock="Right" Content="从第1课开始" Command="{Binding BeginnerCommand}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="OpenBeginnerExamples"/><StackPanel Margin="0,0,12,0"><TextBlock Text="第一次使用？先学显示 → 裁切 → 集合 → 逐项循环" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="5个小案例，不需模型、Python或设备。每课都有操作步骤、预期结果和可修改的小练习。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
  </StackPanel>
  <StackPanel Grid.Row="1"><Border Background="{DynamicResource StudioToolbox}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="打开AI入门" Click="AiStarter_Click" AutomationProperties.AutomationId="OpenAiStarter" ToolTip="自制数据、标注、切片、训练、测试、部署；需已有Python和本地权重，不会自动下载或训练。"/><Button Content="RTU协议模拟" Command="{Binding RtuSimulationCommand}" AutomationProperties.AutomationId="RunRtuProtocolSimulation" ToolTip="仅协议模拟，不打开实体串口。"/></WrapPanel><TextBlock Text="更多示例：AI与通信" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel></Border><DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="刷新示例" Command="{Binding ReloadCommand}"/><ComboBox DockPanel.Dock="Right" Width="150" Margin="8,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.AutomationId="ExampleCategory"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Padding="9,7" ToolTip="搜索名称、标签或英文标识" AutomationProperties.AutomationId="ExampleSearch"/></DockPanel></StackPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ExampleList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
    <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,0,1" Padding="8,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Image Source="{Binding PreviewPath}" Width="112" Height="78" Stretch="Uniform"/>
     <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{Binding Manifest.Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Manifest.Description}" TextWrapping="Wrap" MaxHeight="48" Margin="0,5"/><TextBlock Foreground="{DynamicResource StudioMutedForeground}"><Run Text="{Binding Manifest.Category}"/><Run Text=" · "/><Run Text="{Binding Manifest.Difficulty}"/></TextBlock></StackPanel>
    </Grid></Border></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="2" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="{Binding Selected.Manifest.Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Selected.TagsText}" Foreground="{DynamicResource StudioPrimary}" Margin="0,7,0,16" TextWrapping="Wrap"/>
    <Image Source="{Binding Selected.PreviewPath}" MaxHeight="100" Stretch="Uniform" HorizontalAlignment="Left"/>
    <TextBlock Text="{Binding Selected.Manifest.Description}" TextWrapping="Wrap" Margin="0,18,0,12"/>
    <StackPanel Visibility="{Binding HasGuide,Converter={StaticResource GuideVisibility}}"><TextBlock Text="这一课学什么" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Manifest.LearningGoals}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBlock Text="数据怎样流动" FontWeight="Bold"/><Border Background="{DynamicResource StudioToolbox}" Padding="10" CornerRadius="4" Margin="0,6,0,12"><TextBlock Text="{Binding Selected.Manifest.Flow}" TextWrapping="Wrap"/></Border></StackPanel>
    <ItemsControl ItemsSource="{Binding Selected.Manifest.ExternalDependencies}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource StudioWarning}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="操作说明" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Manifest.Instructions}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <StackPanel Visibility="{Binding HasGuide,Converter={StaticResource GuideVisibility}}"><TextBlock Text="运行后应看到什么" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Manifest.ExpectedSummary}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBlock Text="动手试一试（在工程副本中）" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Manifest.TryIt}" TextWrapping="Wrap" Margin="0,6,0,12"/><TextBlock Text="修改参数后点击应用，再在编辑器按F5运行；回到示例中心再次一键运行会新建初始副本。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,0,0,12"/></StackPanel>
    <TextBlock Text="验证方法" FontWeight="Bold"/><TextBlock Text="{Binding Selected.Manifest.Verification}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" DisplayMemberPath="Name" ToolTip="选择测试图像与预期结果" Margin="0,0,0,12"/>
    <TextBlock Text="预期结果" FontWeight="Bold"/><TextBlock Text="{Binding ExpectedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <TextBlock Text="{Binding LastVerification.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,5"/>
    <ItemsControl ItemsSource="{Binding LastVerification.Details}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource StudioFailure}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="{Binding LastReceivedMessage}" TextWrapping="Wrap" MaxHeight="100"/>
    <TextBlock Text="{Binding LastCopiedProjectPath}" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap" Margin="0,12"/>
   </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,10,0,0"><WrapPanel><Button Content="打开流程" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="OpenExample"/><Button Content="一键运行" Command="{Binding RunCommand}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="RunExample"/><Button Content="复制为新工程" Command="{Binding CopyCommand}" AutomationProperties.AutomationId="CopyExample"/></WrapPanel><Button Content="启动本地通信测试" Command="{Binding LocalTcpCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.AutomationId="RunLocalTcpExample" Visibility="{Binding HasCommunication,Converter={StaticResource GuideVisibility}}"/></StackPanel></Grid></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="取消示例操作" Command="{Binding CancelCommand}"/><TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
 </Grid>
</UserControl>
