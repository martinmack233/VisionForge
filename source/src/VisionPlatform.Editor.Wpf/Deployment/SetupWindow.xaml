<Window x:Class="VisionPlatform.Editor.Wpf.Deployment.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="首次配置与部署诊断" Width="1050" Height="780" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource StudioBackground}" Foreground="{DynamicResource StudioForeground}">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="配置这台检测工作站" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="核心检测可直接使用。AI检测、训练和真实相机分别按需配置；检查不会下载、训练、连接相机或更换后端。" TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="{DynamicResource StudioWarning}" Margin="0,0,0,8"/><WrapPanel><Button x:Name="CheckButton" Content="重新检查" Click="Check_Click" Style="{DynamicResource StudioPrimaryButton}"/><Button x:Name="SaveButton" Content="保存本机配置 / 完成向导" Click="Save_Click"/><Button x:Name="ExportButton" Content="导出脱敏诊断" Click="Export_Click" IsEnabled="False"/><Button Content="取消检查" Click="Cancel_Click"/><Button Content="关闭，继续核心检测" Click="Close_Click"/></WrapPanel></StackPanel>
    <TabControl>
      <TabItem Header="检查结果"><DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Text="点击“重新检查”。未配置的可选组件不阻止传统视觉、工程编辑或虚拟相机。缺失/不兼容项会给出处理方法。" TextWrapping="Wrap" Margin="0,0,0,12"/><ListView x:Name="Results" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,9" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" Background="{DynamicResource StudioPanel}" CornerRadius="5"><StackPanel><TextBlock FontWeight="SemiBold"><Run Text="{Binding Name,Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Status,Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,6,0,4"/><TextBlock Text="{Binding Remedy}" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView></DockPanel></TabItem>
      <TabItem Header="AI检测组件"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
        <TextBlock Text="现有Python环境（检测专用或已验证的现有环境）"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择" Click="ChooseDetectionPython_Click"/><TextBox x:Name="DetectionPython"/></DockPanel>
        <TextBlock Text="独立检测组件目录（含component.json，不是训练仓库）"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择" Click="ChooseComponent_Click"/><TextBox x:Name="DetectionComponent"/></DockPanel>
        <TextBlock Text="后端：ONNX CPU（固定协议，不切换PT/CUDA）" FontWeight="SemiBold"/><TextBlock Text="模型路径仅用于本轮诊断，不保存为全局默认模型，不替换工程参数。" TextWrapping="Wrap" Margin="0,12,0,6"/><DockPanel><Button DockPanel.Dock="Right" Content="选择ONNX" Click="ChooseModel_Click"/><TextBox x:Name="ModelPath"/></DockPanel>
        <Separator Margin="0,18"/><TextBlock Text="从有权使用的本地YOLOStudio制作检测组件" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="只提取锁定版本的推理、切片与后处理业务；不复制Qt、数据库、训练worker、权重或环境。此操作不表示获得对外再分发许可。原工作区和.venv保持原样。" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <TextBlock Text="已有源码目录"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择来源" Click="ChooseSource_Click"/><TextBox x:Name="ComponentSource"/></DockPanel><TextBlock Text="新组件目录（必须不存在）"/><TextBox x:Name="ComponentDestination" Margin="0,5,0,12"/>
        <CheckBox x:Name="LocalRights"><TextBlock Text="我确认有权使用所选来源，仅制作本机组件；再分发授权仍需独立确认" TextWrapping="Wrap" MaxWidth="600"/></CheckBox><Button x:Name="InstallButton" Content="明确制作本机检测组件" Click="Install_Click" IsEnabled="{Binding IsChecked,ElementName=LocalRights}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
        <TextBlock Text="当前ONNX预处理/NMS仍实际依赖torch、torchvision和ultralytics；不等于只安装onnxruntime即可使用。Python和依赖必须符合recipe清单，不自动运行pip。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="可选训练"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><CheckBox x:Name="TrainingEnabled"><TextBlock Text="按需启用原AI训练工作区（核心检测不依赖此选项）" TextWrapping="Wrap" MaxWidth="600"/></CheckBox><StackPanel IsEnabled="{Binding IsChecked,ElementName=TrainingEnabled}" Margin="0,14,0,0"><TextBlock Text="已有YOLOStudio源码目录"/><DockPanel Margin="0,5,0,14"><Button DockPanel.Dock="Right" Content="选择" Click="ChooseTrainingRoot_Click"/><TextBox x:Name="TrainingRoot"/></DockPanel><TextBlock Text="已有训练Python环境"/><DockPanel Margin="0,5,0,14"><Button DockPanel.Dock="Right" Content="选择" Click="ChooseTrainingPython_Click"/><TextBox x:Name="TrainingPython"/></DockPanel></StackPanel><TextBlock Text="保存只更新机器配置。需要训练时在AI工作区显式连接；沿用原数据路径、任务锁、TrainingService和worker。向导不打开数据库、启动训练或自动使用GPU。关闭此选项不会删除任何数据或停止已有任务。" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="相机与目录"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="合法安装的博峤SDK（可留空，不随默认包分发）"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择DLL" Click="ChooseSdk_Click"/><TextBox x:Name="BoqSdk"/></DockPanel><TextBlock Text="隔离Worker绝对路径"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择EXE" Click="ChooseWorker_Click"/><TextBox x:Name="BoqWorker"/></DockPanel><TextBlock Text="厂商驱动目录（目录存在不代表硬件已验证）"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseDriver_Click"/><TextBox x:Name="DriverDirectory"/></DockPanel><TextBlock Text="用户可写数据目录"/><TextBox x:Name="DataDirectory" Margin="0,5,0,12"/><TextBlock Text="缓存目录"/><TextBox x:Name="CacheDirectory" Margin="0,5,0,12"/><TextBlock Text="日志目录"/><TextBox x:Name="LogDirectory" Margin="0,5,0,12"/><TextBlock Text="检查仅创建并删除本次GUID写入测试文件。升级保留用户目录；诊断导出默认不含路径、模型名、模型哈希、原始异常、密钥或业务数据。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
