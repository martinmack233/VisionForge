<Window x:Class="VisionPlatform.Editor.Wpf.Deployment.ProjectPackageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="工程包 · 导出、预检与资源重定位" Width="1060" Height="740" MinWidth="760" MinHeight="550" WindowStartupLocation="CenterOwner" Background="{DynamicResource StudioBackground}" Foreground="{DynamicResource StudioForeground}">
  <DockPanel Margin="18"><TextBlock DockPanel.Dock="Top" Text="可携带的检测工程" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource StudioWarning}" Margin="0,10,0,8"/><WrapPanel><Button Content="取消当前操作" Click="Cancel_Click"/><Button Content="关闭" Click="Close_Click"/></WrapPanel></StackPanel>
    <TabControl x:Name="PackageTabs"><TabItem Header="导出当前工程"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16"><TextBlock Text="包含主流程、子流程、参数、ROI、显示样式及已声明模板/输入资源。机器Python路径、SDK、数据库、训练集、日志和缓存不进入包。" TextWrapping="Wrap"/><TextBlock Text="当前工程（有修改时须先保存；不读取执行缓存）" Margin="0,16,0,5"/><TextBox x:Name="SourceProject" IsReadOnly="True"/><Button Content="先保存当前工程" Click="SaveProject_Click" HorizontalAlignment="Left" Margin="0,8,0,12"/><CheckBox x:Name="IncludeModels"><TextBlock Text="携带ONNX模型、deployment.json和显式OCR字库（默认仅外部引用）" TextWrapping="Wrap" MaxWidth="600"/></CheckBox><CheckBox x:Name="Rights" Margin="0,12,0,8"><TextBlock Text="我确认有权将所选模型/字库携带到目标机器；此项不表示获得商业发行许可" TextWrapping="Wrap" MaxWidth="600"/></CheckBox><TextBlock Text="外部引用只保存内容哈希和资源ID，不保存开发机的绝对位置。输入图像与模板是明确的工程资源；导出前请确认其中没有不应携带的业务图片。AI数据关联保留独立ID提示，不复制AI数据库，也不自动绑定目标机器的数据目录。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,4,0,16"/><Button x:Name="ExportButton" Content="检查依赖并导出新工程包…" Click="Export_Click" Style="{DynamicResource StudioPrimaryButton}" HorizontalAlignment="Left"/><TextBox x:Name="ExportSummary" IsReadOnly="True" TextWrapping="Wrap" MinHeight="100" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="预检与导入"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="16" MinHeight="530"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="工程包 (*.vspkg)"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择包" Click="ChoosePackage_Click"/><Button DockPanel.Dock="Right" Content="预检" Click="Inspect_Click"/><TextBox x:Name="PackagePath" TextChanged="PackagePath_Changed"/></DockPanel></StackPanel>
        <StackPanel Grid.Row="1"><TextBlock Text="新导入目录（必须不存在，不覆盖任何现有工程）"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="选择父目录" Click="ChooseDestination_Click"/><TextBox x:Name="Destination"/></DockPanel></StackPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,12"><TextBlock Text="工程名称" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="ImportName" MinWidth="210"/></DockPanel>
        <TextBlock Grid.Row="3" x:Name="InspectionSummary" Text="先选择工程包并预检。完整资源哈希、版本和同名冲突会在导入前再次检查。" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <DataGrid Grid.Row="4" x:Name="ResourceGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="资源ID" Binding="{Binding Id}" IsReadOnly="True" Width="75"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" IsReadOnly="True" Width="105"/><DataGridTextColumn Header="内容" Binding="{Binding Name}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="方式" Binding="{Binding Mode}" IsReadOnly="True" Width="95"/><DataGridTextColumn Header="外部资源重定位（保持原哈希）" Binding="{Binding RelocationPath,UpdateSourceTrigger=PropertyChanged}" Width="270"/></DataGrid.Columns></DataGrid>
        <StackPanel Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="外部模型选择ONNX，deployment.json必须同目录且哈希一致。字库/虚拟图像源选择目录。哈希不同必须回源工程重新验证，不沿用旧“已验证”状态。虚拟图像源仅保留引用，不导出整个文件夹。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}"/><WrapPanel Margin="0,10,0,0"><Button Content="定位选中的外部资源…" Click="Locate_Click"/><Button x:Name="ImportButton" Content="导入到新目录" Click="Import_Click" IsEnabled="False" Style="{DynamicResource StudioPrimaryButton}"/><Button x:Name="OpenImportedButton" Content="打开已导入工程（不运行）" Click="OpenImported_Click" IsEnabled="False"/></WrapPanel></StackPanel>
      </Grid></ScrollViewer></TabItem>
    </TabControl>
  </DockPanel>
</Window>
