<UserControl x:Class="VisionPlatform.Editor.Wpf.Devices.DevicesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:imaging="clr-namespace:VisionPlatform.Editor.Wpf.Imaging"
 Background="{DynamicResource StudioBackground}" Foreground="{DynamicResource StudioForeground}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
 <Grid Margin="18" MinHeight="580"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="设备管理" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="选择设备源 → 选择设备 → 配置并打开 → 预览 → 绑定工程节点 → 检测" Margin="0,6,0,16" Foreground="{DynamicResource StudioMutedForeground}"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,12">
   <Button Content="枚举设备" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RefreshDevices"/>
   <Button Content="打开相机" Command="{Binding OpenCommand}" AutomationProperties.AutomationId="OpenCamera"/>
   <Button Content="单帧预览" Command="{Binding CaptureCommand}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="CaptureCamera"/>
   <Button Content="开始连续预览" Command="{Binding StartCommand}" AutomationProperties.AutomationId="StartCamera"/>
   <Button Content="停止并冻结" Command="{Binding StopCommand}" AutomationProperties.AutomationId="StopCamera"/>
   <Button Content="清空图像" Command="{Binding ClearPreviewCommand}" AutomationProperties.AutomationId="ClearCameraPreview"/>
   <Button Content="关闭相机" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="CloseCamera"/>
   <TextBlock Text="{Binding DisplayDeviceState}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" AutomationProperties.AutomationId="CameraState"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <Border Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="设备与连接" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,0,0,8"/>
     <StackPanel IsEnabled="{Binding CanEditConnection}" Visibility="{Binding ConnectionDraftVisibility}">
      <TextBlock Text="设备源"/><ComboBox ItemsSource="{Binding DeviceSources}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProviderId,Mode=TwoWay}" Margin="0,4,0,10" AutomationProperties.AutomationId="CameraSource"/>
      <TextBlock Text="设备（枚举结果）"/><ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice,Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,4,0,10" ToolTip="博峤模拟设备会明确标识；枚举不代表真实相机采集已通过" AutomationProperties.AutomationId="CameraDevice"/>
      <TextBlock Text="相机会话标识"/><TextBox Text="{Binding CameraId,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="6" AutomationProperties.AutomationId="CameraId"/>
      <StackPanel Visibility="{Binding VirtualOptionsVisibility}">
      <TextBlock Text="图像文件夹（非递归，按文件名排序）"/><DockPanel Margin="0,4,0,10"><Button DockPanel.Dock="Right" Content="浏览" Click="BrowseFolder_Click" AutomationProperties.AutomationId="BrowseCameraFolder"/><TextBox Text="{Binding FolderPath,UpdateSourceTrigger=PropertyChanged}" Padding="6" AutomationProperties.AutomationId="CameraFolder"/></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="帧率上限（Hz）"/><TextBox Text="{Binding FrameRateText,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" Padding="6" AutomationProperties.AutomationId="CameraFrameRate"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="文件像素解释"/><ComboBox ItemsSource="{Binding PixelFormats}" SelectedItem="{Binding PixelFormatChoice}" Margin="0,4,0,10" Padding="4" AutomationProperties.AutomationId="CameraPixelFormat"/></StackPanel>
      </Grid>
      <CheckBox Content="循环播放" IsChecked="{Binding Loop}" Margin="0,0,0,8" AutomationProperties.AutomationId="CameraLoop"/>
      </StackPanel>
     </StackPanel>
     <TextBlock Text="{Binding ConfigurationError}" TextWrapping="Wrap" Foreground="{DynamicResource StudioFailure}" AutomationProperties.AutomationId="CameraConfigurationError"/>
     <TextBlock Text="{Binding ProviderDiagnostic}" TextWrapping="Wrap" Foreground="{DynamicResource StudioWarning}" Margin="0,4"/>
     <TextBlock Text="{Binding ConfigurationState}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,6"/>
     <Button Content="关闭并重新读取工程配置" Command="{Binding ReloadNodeCommand}" Padding="6,3"/>
    </StackPanel></Border>
    <Border Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12"><StackPanel>
     <TextBlock Text="设备能力参数" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="只显示设备实际能力；虚拟相机不提供曝光、增益或硬件触发。只读参数不能写入。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,0,0,8"/>
     <ItemsControl ItemsSource="{Binding Parameters}" AutomationProperties.AutomationId="CameraParameters"><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource StudioBorder}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
       <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AccessDescription}" Foreground="{DynamicResource StudioMutedForeground}" FontSize="11"/><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" ToolTip="{Binding Name}"/></DockPanel>
       <DockPanel Margin="0,5,0,2"><Button DockPanel.Dock="Right" Content="{Binding ApplyLabel}" Command="{Binding DataContext.ApplyParameterCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" IsEnabled="{Binding CanWrite}" Padding="7,3"/>
        <Grid IsEnabled="{Binding CanWrite}" Visibility="{Binding ValueEditorVisibility}">
         <TextBox Text="{Binding ValueText,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding TextVisibility}" Padding="5"/>
         <CheckBox IsChecked="{Binding BooleanValue}" Visibility="{Binding BooleanVisibility}" VerticalAlignment="Center"/>
         <ComboBox ItemsSource="{Binding AllowedValues}" SelectedItem="{Binding ValueText,Mode=TwoWay}" Visibility="{Binding EnumerationVisibility}" Padding="4"/>
        </Grid>
       </DockPanel>
       <TextBlock Text="{Binding RangeDescription}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}"/>
       <TextBlock Text="{Binding UnitStepDescription}" FontSize="10" Foreground="{DynamicResource StudioMutedForeground}"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10"><StackPanel>
     <WrapPanel><Button Content="写入/选择相机节点" Command="{Binding ConfigureNodeCommand}" AutomationProperties.AutomationId="ConfigureCameraNode"/><Button Content="检测当前冻结帧" Command="{Binding DetectFrozenCommand}" AutomationProperties.AutomationId="DetectFrozenFrame"/><Button Content="采集新帧并检测" Command="{Binding RunProjectCommand}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="RunCameraProject"/><Button Content="开始连续检测" Command="{Binding StartDetectionCommand}" AutomationProperties.AutomationId="StartContinuousDetection"/></WrapPanel>
     <TextBlock Text="连续预览只显示图像；连续检测需单独启动。检测等待队列最多1帧，繁忙时保留最新帧，停止会取消待检任务。打开工程或修改参数不会采集、检测或发送结果。" TextWrapping="Wrap" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,7,0,0"/>
    </StackPanel></Border>
    <Border Grid.Row="1" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5"><DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="10,8"><TextBlock Text="设备预览 · 只读" FontWeight="SemiBold"/><TextBlock Text="{Binding FrameState}" FontWeight="SemiBold" Foreground="{DynamicResource StudioPrimary}" HorizontalAlignment="Right" Margin="12,0,0,0"/></DockPanel>
     <imaging:ImageViewportControl x:Name="DevicePreview" SourceImage="{Binding PreviewImage}" IsRoiEditingEnabled="False"/>
    </DockPanel></Border>
    <Border Grid.Row="2" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding FrameDescription}" TextWrapping="Wrap" AutomationProperties.AutomationId="CameraFrameInfo"/><TextBlock Text="{Binding Statistics}" Foreground="{DynamicResource StudioMutedForeground}" Margin="0,5,0,0" AutomationProperties.AutomationId="CameraStatistics"/></StackPanel></Border>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="DeviceStatus"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource StudioFailure}" TextWrapping="Wrap"/></StackPanel>
 </Grid>
 </ScrollViewer>
</UserControl>
