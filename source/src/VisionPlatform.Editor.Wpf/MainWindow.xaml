<Window x:Class="VisionPlatform.Editor.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:product="clr-namespace:VisionPlatform.Contracts.Build;assembly=VisionPlatform.Contracts"
        xmlns:collections="clr-namespace:VisionPlatform.Editor.Wpf.Collections" xmlns:graph="clr-namespace:VisionPlatform.Editor.Wpf.Graph" xmlns:imaging="clr-namespace:VisionPlatform.Editor.Wpf.Imaging" xmlns:parameters="clr-namespace:VisionPlatform.Editor.Wpf.Parameters" xmlns:workspace="clr-namespace:VisionPlatform.Editor.Wpf.Workspace" xmlns:local="clr-namespace:VisionPlatform.Editor.Wpf"
        Title="{x:Static product:ProductBuild.Name}" Width="1550" Height="990" MinWidth="820" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource StudioBackground}" Foreground="{DynamicResource StudioForeground}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
  <Window.Resources><workspace:WorkspacePageVisibilityConverter x:Key="WorkspaceVisibility"/></Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Workspace.NavigationWidth,RelativeSource={RelativeSource AncestorType=Window}}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <workspace:NavigationRail DataContext="{Binding Workspace,RelativeSource={RelativeSource AncestorType=Window}}"/>
    <workspace:WorkspacePageHost x:Name="WorkspacePages" Grid.Column="1" DataContext="{Binding Workspace,RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding Workspace.CurrentPage,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource WorkspaceVisibility},ConverterParameter=!Editor}"/>
  <Grid x:Name="EditorWorkspace" Grid.Column="1" Margin="10" Visibility="{Binding Workspace.CurrentPage,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource WorkspaceVisibility},ConverterParameter=Editor}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><Border Background="{DynamicResource StudioPrimary}" Width="6" Margin="0,1,12,1" CornerRadius="2"/><TextBlock Text="{x:Static product:ProductBuild.Name}" FontSize="24" FontWeight="Bold"/><TextBlock Text="工业视觉开发工作台" VerticalAlignment="Bottom" Margin="16,0,0,3" Foreground="{DynamicResource StudioMutedForeground}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="工程" VerticalAlignment="Center" Margin="0,0,9,0" Foreground="{DynamicResource StudioMutedForeground}"/><TextBox Text="{Binding ProjectName,Mode=TwoWay,UpdateSourceTrigger=LostFocus}" Width="220" Padding="8,5" AutomationProperties.AutomationId="ProjectName"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,12">
      <DockPanel><Menu DockPanel.Dock="Top" Margin="0,0,0,7" AutomationProperties.AutomationId="EditorMenu"><MenuItem Header="文件(_F)"><MenuItem Header="新建工程" Command="{x:Static local:StudioCommands.New}" InputGestureText="Ctrl+N"/><MenuItem Header="打开工程" Command="{x:Static local:StudioCommands.Open}" InputGestureText="Ctrl+O"/><Separator/><MenuItem Header="保存" Command="{x:Static local:StudioCommands.Save}" InputGestureText="Ctrl+S"/><MenuItem Header="另存为" Command="{x:Static local:StudioCommands.SaveAs}" InputGestureText="Ctrl+Shift+S"/></MenuItem><MenuItem Header="编辑(_E)"><MenuItem Header="撤销" Command="{Binding UndoCommand,ElementName=GraphView}" InputGestureText="Ctrl+Z"/><MenuItem Header="重做" Command="{Binding RedoCommand,ElementName=GraphView}" InputGestureText="Ctrl+Y"/><Separator/><MenuItem Header="复制节点" Command="{Binding CopyCommand,ElementName=GraphView}" InputGestureText="Ctrl+C"/><MenuItem Header="粘贴节点" Command="{Binding PasteCommand,ElementName=GraphView}" InputGestureText="Ctrl+V"/><MenuItem Header="剪切节点" Command="{Binding CutCommand,ElementName=GraphView}" InputGestureText="Ctrl+X"/><MenuItem Header="复制副本" Command="{Binding DuplicateCommand,ElementName=GraphView}" InputGestureText="Ctrl+D"/><MenuItem Header="全选节点" Command="{Binding SelectAllCommand,ElementName=GraphView}" InputGestureText="Ctrl+A"/><MenuItem Header="重命名" Command="{Binding RenameCommand,ElementName=GraphView}" InputGestureText="F2"/><MenuItem Header="删除" Command="{Binding DeleteCommand,ElementName=GraphView}" InputGestureText="Delete"/></MenuItem><MenuItem Header="部署(_D)"><MenuItem Header="首次配置 / 部署诊断" Click="Setup_Click"/><MenuItem Header="工程包导出 / 导入 / 重定位" Click="Packages_Click"/></MenuItem><MenuItem Header="运行(_R)"><MenuItem Header="运行流程" Command="{x:Static local:StudioCommands.Run}" InputGestureText="F5"/><MenuItem Header="运行此节点" Command="{x:Static local:StudioCommands.RunSingle}" InputGestureText="F6"/><MenuItem Header="运行到此处" Command="{x:Static local:StudioCommands.RunTo}"/><MenuItem Header="取消运行" Command="{x:Static local:StudioCommands.Cancel}"/></MenuItem></Menu><WrapPanel>
        <Button Content="新建 Ctrl+N" Command="{x:Static local:StudioCommands.New}" AutomationProperties.AutomationId="NewProject"/><Button Content="打开 Ctrl+O" Command="{x:Static local:StudioCommands.Open}" AutomationProperties.AutomationId="OpenProject"/><Button Content="保存 Ctrl+S" Command="{x:Static local:StudioCommands.Save}" AutomationProperties.AutomationId="SaveProject"/><Button Content="另存为 Ctrl+Shift+S" Command="{x:Static local:StudioCommands.SaveAs}"/>
        <Button Content="导入图像" Click="Import_Click" AutomationProperties.AutomationId="ImportImage"/><ComboBox x:Name="ImportFormat" SelectedIndex="0" Width="116" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="文件解释方式；原始Bayer需明确选择"><ComboBoxItem Content="自动格式"/><ComboBoxItem Content="Mono8"/><ComboBoxItem Content="BayerRG8"/><ComboBoxItem Content="BayerGB8"/><ComboBoxItem Content="RGB8"/><ComboBoxItem Content="BGR8"/></ComboBox>
        <Button Content="示例工程" Click="Demo_Click" AutomationProperties.AutomationId="DemoProject"/>
        <Border Width="1" Background="{DynamicResource StudioBorder}" Margin="5,0,12,0"/>
        <Button Content="▶ 运行 F5" Command="{x:Static local:StudioCommands.Run}" Style="{DynamicResource StudioPrimaryButton}" AutomationProperties.AutomationId="RunAll"/><Button Content="此节点 F6" Command="{x:Static local:StudioCommands.RunSingle}" AutomationProperties.AutomationId="RunSingle"/><Button Content="运行到此处" Command="{x:Static local:StudioCommands.RunTo}"/><Button Content="取消" Command="{x:Static local:StudioCommands.Cancel}" AutomationProperties.AutomationId="CancelRun"/>
      </WrapPanel></DockPanel>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition x:Name="InspectorColumn" Width="315" MinWidth="240"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition x:Name="FlowRow" Height="1.05*" MinHeight="80"/><RowDefinition x:Name="ViewSplitterRow" Height="7"/><RowDefinition x:Name="ImageRow" Height="1*" MinHeight="80"/></Grid.RowDefinitions>
        <Border x:Name="FlowPane" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5"><DockPanel><Border DockPanel.Dock="Top" Padding="9,5" Background="{DynamicResource StudioToolbox}"><DockPanel><TextBlock Text="算法流程" FontWeight="SemiBold" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" x:Name="MaximizeFlowButton" Content="放大流程" Click="MaximizeFlow_Click" Padding="7,2" Margin="8,0,0,0" AutomationProperties.AutomationId="MaximizeFlow"/><TextBlock DockPanel.Dock="Right" Text="拖入算子 · 右键更多操作" Foreground="{DynamicResource StudioMutedForeground}" HorizontalAlignment="Right"/></DockPanel></Border><graph:GraphEditorView x:Name="GraphView" Session="{Binding}"/></DockPanel></Border>
        <GridSplitter x:Name="ViewSplitter" Grid.Row="1" Height="4" DragCompleted="LayoutSplitter_DragCompleted" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
        <Border x:Name="ImagePane" Grid.Row="2" Background="{DynamicResource StudioPanel}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" CornerRadius="5"><DockPanel><Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource StudioToolbox}"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="MaximizeImageButton" Content="放大图像" Click="MaximizeImage_Click" Padding="6,2" AutomationProperties.AutomationId="MaximizeImage"/><Button Content="双视图" Click="RestoreViews_Click" Padding="6,2" AutomationProperties.AutomationId="RestoreViews"/><Menu Background="Transparent" Padding="0"><MenuItem Header="ROI" Padding="6,2"><MenuItem Header="绑定 ROI 到节点" Click="BindRoi_Click"/><MenuItem Header="用 ROI 教学模板" Click="Teach_Click"/></MenuItem></Menu></StackPanel><TextBlock Text="图像" VerticalAlignment="Center" FontWeight="SemiBold" ToolTip="使用原始像素坐标；缩放和平移不影响检测结果。"/></DockPanel></Border><imaging:ImageViewportControl x:Name="Viewport" SourceImage="{Binding DisplayImage}" Overlays="{Binding Overlays}" MeasurementOverlays="{Binding MeasurementOverlays}" RecognitionOverlays="{Binding RecognitionOverlays}" CollectionDisplay="{Binding CollectionDisplay}" CollectionSelection="{Binding CollectionSelection}" EditableRoi="{Binding EditedRoi}"/></DockPanel></Border>
      </Grid>
      <GridSplitter Grid.Column="1" Width="4" DragCompleted="LayoutSplitter_DragCompleted" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
      <TabControl Grid.Column="2" x:Name="InspectorTabs"><TabItem Header="节点参数"><parameters:ParameterPanel x:Name="ParametersView" Foreground="{DynamicResource StudioForeground}" Session="{Binding}"/></TabItem>
        <TabItem Header="执行结果"><DockPanel Margin="8"><TextBlock DockPanel.Dock="Top" Text="选择节点查看输出；点击图像输出进行预览" Foreground="{DynamicResource StudioMutedForeground}" TextWrapping="Wrap" Margin="2,2,2,10"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedNode.ErrorMessage}" Foreground="{DynamicResource StudioFailure}" TextWrapping="Wrap" MaxHeight="75" ToolTip="{Binding SelectedNode.ErrorMessage}"/>
          <Border DockPanel.Dock="Top" Background="{DynamicResource StudioToolbox}" BorderBrush="{DynamicResource StudioBorder}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding CurrentInspectionReport}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <ContentControl Content="{Binding CurrentInspectionReport}"><ContentControl.ContentTemplate><DataTemplate><StackPanel>
              <TextBlock FontSize="23" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="NG"/><Setter Property="Foreground" Value="{DynamicResource StudioFailure}"/><Style.Triggers><DataTrigger Binding="{Binding IsOk}" Value="True"><Setter Property="Text" Value="OK"/><Setter Property="Foreground" Value="{DynamicResource StudioSuccess}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              <TextBlock Text="{Binding BlobCount,StringFormat=目标数量：{0}}"/><TextBlock Text="{Binding MatchScore,StringFormat=匹配分数：{0:F4}}"/>
              <WrapPanel><TextBlock Text="{Binding CenterX,StringFormat=X：{0:F3}  }"/><TextBlock Text="{Binding CenterY,StringFormat=Y：{0:F3}}"/></WrapPanel>
              <WrapPanel><TextBlock Text="{Binding Angle,StringFormat=角度：{0:F3}°  }"/><TextBlock Text="{Binding Scale,StringFormat=尺度：{0:F4}}"/></WrapPanel>
              <TextBlock Text="{Binding ExecutionMilliseconds,StringFormat=算法耗时：{0:F3} ms}"/>
              <TextBlock Text="{Binding Communication.Description,StringFormat=通信：{0}}" TextWrapping="Wrap"/>
              <ContentControl Content="{Binding Measurement}"><ContentControl.ContentTemplate><DataTemplate><StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding Kind,StringFormat=测量：{0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Unit,StringFormat=单位：{0}}"/><ItemsControl ItemsSource="{Binding Values}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Key}" Width="105"/><TextBlock Text="{Binding Value,StringFormat=G8}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding ErrorReason}" TextWrapping="Wrap" Foreground="{DynamicResource StudioFailure}"/></StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
            </StackPanel></DataTemplate></ContentControl.ContentTemplate></ContentControl>
          </Border>
          <Grid><Grid.RowDefinitions><RowDefinition Height="1.2*"/><RowDefinition Height="8"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
            <DataGrid x:Name="ExecutionGrid" ItemsSource="{Binding Results}" IsReadOnly="True" AutoGenerateColumns="False" SelectionChanged="ResultSelection_Changed" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single" MinColumnWidth="58"><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Error}"/></Style></DataGrid.RowStyle><DataGrid.Columns><DataGridTextColumn Header="节点" Binding="{Binding Name}" Width="*" MinWidth="120"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="74" MinWidth="74"/><DataGridTextColumn Header="ms" Binding="{Binding Milliseconds,StringFormat=F2}" Width="64" MinWidth="64"/></DataGrid.Columns></DataGrid>
            <DockPanel Grid.Row="2">
              <TextBlock DockPanel.Dock="Top" Text="当前节点输出 · 按数据类型分组" FontWeight="SemiBold" Margin="2,0,2,5"/>
              <ListBox x:Name="OutputList" DockPanel.Dock="Top" MaxHeight="145" ItemsSource="{Binding SelectedOutputs}" SelectionChanged="OutputSelection_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource StudioPrimary}" Margin="5,5,5,1"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,4"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DataType}" FontSize="10" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="{Binding PortName}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="35" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="0,6,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel><Button DockPanel.Dock="Right" Content="文本详情" Click="FullText_Click" Padding="5,2" ToolTip="分页查看或复制完整文本，不改变原始数据"/><TextBlock Text="{Binding SelectedOutputInspection.PortName,TargetNullValue=点击输出端口或列表项查看实际字段}" FontWeight="SemiBold" Margin="3,2,3,4"/></DockPanel>
                <DataGrid Grid.Row="1" x:Name="OutputDetailsGrid" ItemsSource="{Binding SelectedOutputInspection.Fields}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="65"><DataGrid.Columns><DataGridTextColumn Header="字段" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
              </Grid>
            </DockPanel>
          </Grid></DockPanel></TabItem>
        <TabItem Header="集合/逐项"><collections:CollectionResultsView x:Name="CollectionsView" Session="{Binding}"/></TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="3" Margin="0,6,0,0" Padding="9,5" Background="{DynamicResource StudioPanel}" CornerRadius="3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0"><TextBlock Text="图像结果缓存：" Foreground="{DynamicResource StudioMutedForeground}"/><TextBlock Text="{Binding RetainedImageBytes,StringFormat={}{0:N0} B}"/><TextBlock Text="  ·  检测坐标：原图像素" Foreground="{DynamicResource StudioMutedForeground}" Margin="12,0,0,0"/></StackPanel></Grid></Border>
  </Grid>
  </Grid>
</Window>
