  "Project": "project.json",
  "Preview": "preview.png",
  "Instructions": "1. \u70B9\u51FB\u201C\u4E00\u952E\u8FD0\u884C\u201D\uFF0C\u8F6F\u4EF6\u4F1A\u521B\u5EFA\u53EF\u5199\u526F\u672C\u3002\n2. \u9009\u201C\u2462 \u770B\u56FE\u50CF\u548C\u76EE\u6807\u6846\u201D\uFF0C\u67E5\u770BImage\u8F93\u51FA\u53CA3\u4E2A\u76EE\u6807\u6846\uFF1B\u70B9\u51FB\u56FE\u50CF\u8F93\u51FA\u7AEF\u53E3\u53EF\u9884\u89C8\u3002\n3. \u9009\u201C\u2463 \u770B\u6570\u5B57\u8F6C\u6587\u5B57\u201D\u548C\u201C\u2465 \u770B\u5E03\u5C14\u7ED3\u679C\u201D\uFF0C\u67E5\u770B\u8282\u70B9\u6458\u8981\u548C\u53F3\u4FA7\u201C\u6267\u884C\u7ED3\u679C\u201D\u3002\n4. \u9009\u201C\u2464 \u6570\u91CF\u662F\u5426\u7B49\u4E8E3\u201D\uFF0C\u5728\u53C2\u6570\u9762\u677F\u67E5\u770B\u6BD4\u8F83\u76EE\u6807\u503C\u3002\u56FE\u50CF\u7AEF\u53E3\u4E0D\u80FD\u76F4\u63A5\u8FDE\u63A5\u6587\u5B57\u7AEF\u53E3\u3002",
  "Flow": "\u56FE\u7247 \u2192 Blob\u68C0\u6D4B \u2192 \u56FE\u50CF\u663E\u793A\n\u76EE\u6807\u6570\u91CF \u2192 \u6587\u672C\u663E\u793A\uFF1B\u6570\u91CF\u6BD4\u8F83 \u2192 \u5E03\u5C14\u663E\u793A",
  "LearningGoals": "\u533A\u5206\u56FE\u50CF\u3001\u6574\u6570\u3001Boolean\u7AEF\u53E3\uFF1B\u77E5\u9053\u8282\u70B9\u6267\u884C\u6210\u529F\u548C\u4E1A\u52A1\u5224\u65ADTrue\u662F\u4E24\u56DE\u4E8B\u3002",
  "TryIt": "\u628A\u6BD4\u8F83\u76EE\u6807\u503C3\u6539\u62102\uFF0C\u5E94\u7528\u540E\u91CD\u65B0\u8FD0\u884C\uFF1A\u5E03\u5C14\u663E\u793A\u5E94False\uFF0C\u56FE\u50CF\u4E0E\u76EE\u6807\u6570\u91CF\u4ECD\u4E3A3\u3002",
  "ExpectedSummary": "\u76EE\u6807\u6570\u91CF\uFF1A3\uFF1B\u6570\u91CF\u7B49\u4E8E3\uFF1ATrue\uFF1B\u539F\u56FE320\u00D7240\u4E14\u67093\u4E2A\u76EE\u6807\u6846\u3002",
