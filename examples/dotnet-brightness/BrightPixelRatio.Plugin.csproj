<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="VisionPlatform.Contracts">
      <HintPath>$(VisionForgeDir)/VisionPlatform.Contracts.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckVisionForge" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VisionForgeDir)/VisionPlatform.Contracts.dll')"
           Text="Set VisionForgeDir to the complete extracted VisionForge 0.6.3 directory." />
  </Target>
</Project>
